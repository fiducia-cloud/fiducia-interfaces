{
  "openapi": "3.1.1",
  "info": {
    "title": "Fiducia transport parity canary",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/opportunity-admission/evaluate": {
      "post": {
        "operationId": "evaluate_opportunity_admission",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./authored.schema.json#/$defs/OpportunityAdmissionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Admission predicate evaluated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./authored.schema.json#/$defs/OpportunityAdmissionResponse"
                }
              }
            }
          }
        },
        "x-ores-behavior": {
          "kind": "predicate",
          "language": "cel",
          "executable": true,
          "inputs": [
            { "name": "shown_to_alex", "type": "boolean", "required": true },
            { "name": "approved_by_alex", "type": "boolean", "required": true },
            { "name": "legal_terms_accepted", "type": "boolean", "required": true },
            { "name": "payment_obligation_accepted", "type": "boolean", "required": true },
            { "name": "travel_commitment_accepted", "type": "boolean", "required": true },
            { "name": "recording_publicity_consent_accepted", "type": "boolean", "required": true },
            { "name": "relocation_commitment_accepted", "type": "boolean", "required": true }
          ],
          "output": { "type": "boolean", "nullable": false },
          "requires": [],
          "ensures": [
            "result == (shown_to_alex && approved_by_alex && !legal_terms_accepted && !payment_obligation_accepted && !travel_commitment_accepted && !recording_publicity_consent_accepted && !relocation_commitment_accepted)"
          ],
          "invariants": [
            "legal_terms_accepted == false",
            "payment_obligation_accepted == false",
            "travel_commitment_accepted == false",
            "recording_publicity_consent_accepted == false",
            "relocation_commitment_accepted == false"
          ],
          "expression": "shown_to_alex && approved_by_alex && !legal_terms_accepted && !payment_obligation_accepted && !travel_commitment_accepted && !recording_publicity_consent_accepted && !relocation_commitment_accepted",
          "algorithm": null,
          "effects": [],
          "errors": [],
          "deterministic": true,
          "idempotent": true,
          "pure": true
        }
      }
    }
  }
}
